{
  "name": "riad-4-jardins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "npm run content:prepare && vite --host 127.0.0.1",
    "content:prepare": "node scripts/prepare.mjs",
    "build:render": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "build": "npm run content:prepare && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "measure": "node scripts/measure.mjs",
    "capture": "node scripts/capture.mjs",
    "cms:seed": "node scripts/seed-sanity.mjs",
    "cms:import": "npm --prefix studio run import",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "i18next": "^25.3.4",
    "lucide-react": "^0.544.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.6.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.8",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-xml-parser": "^5.11.2",
    "globals": "^16.3.0",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.13",
    "vite": "^8.3.5"
  }
}
