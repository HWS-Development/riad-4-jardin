# Public site origin confirmed by the client.
SITE_URL=https://riad4jardins.com
SITE_NOINDEX=false
GOOGLE_SITE_VERIFICATION=

# Sanity Free: public dataset; published content only. No paid plugin required.
CONTENT_SOURCE=sanity
SANITY_PROJECT_ID=7041qvs5
SANITY_DATASET=production
REQUIRE_SANITY=true
# Local repository-only troubleshooting: CONTENT_SOURCE=repository (never production).
# Write token is needed ONLY for the initial seed. Never prefix it with VITE_.
SANITY_API_WRITE_TOKEN=

# Existing EmailJS public configuration (delivery must be verified separately).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_SPA_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
