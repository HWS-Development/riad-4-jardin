{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "riad4jardin.com" }], "destination": "https://riad4jardins.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.riad4jardin.com" }], "destination": "https://riad4jardins.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.riad4jardins.com" }], "destination": "https://riad4jardins.com/:path*", "permanent": true },
    { "source": "/", "destination": "/fr/", "permanent": true },
    { "source": "/index.html", "destination": "/fr/", "permanent": true },
    { "source": "/chambres", "destination": "/fr/chambres/", "permanent": true },
    { "source": "/spa", "destination": "/fr/spa/", "permanent": true },
    { "source": "/services-activites", "destination": "/fr/services-activites/", "permanent": true },
    { "source": "/restaurant", "destination": "/fr/restaurant/", "permanent": true },
    { "source": "/galerie", "destination": "/fr/galerie/", "permanent": true },
    { "source": "/contact", "destination": "/fr/contact/", "permanent": true },
    { "source": "/conditions-reservation", "destination": "/fr/conditions-reservation/", "permanent": true }
  ],
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] }
  ]
}
