{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "riad4jardin\\.com" }], "destination": "https://riad4jardins.com/:path*", "statusCode": 301 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www\\.riad4jardin\\.com" }], "destination": "https://riad4jardins.com/:path*", "statusCode": 301 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www\\.riad4jardins\\.com" }], "destination": "https://riad4jardins.com/:path*", "permanent": true },
    { "source": "/", "destination": "/fr/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/fr/", "statusCode": 301 },
    { "source": "/home2", "destination": "/fr/", "statusCode": 301 },
    { "source": "/home2/", "destination": "/fr/", "statusCode": 301 },
    { "source": "/chambres", "destination": "/fr/chambres/", "statusCode": 301 },
    { "source": "/chambres/", "destination": "/fr/chambres/", "statusCode": 301 },
    { "source": "/spa", "destination": "/fr/spa/", "statusCode": 301 },
    { "source": "/spa/", "destination": "/fr/spa/", "statusCode": 301 },
    { "source": "/services-activites", "destination": "/fr/services-activites/", "statusCode": 301 },
    { "source": "/services-activites/", "destination": "/fr/services-activites/", "statusCode": 301 },
    { "source": "/restaurant", "destination": "/fr/restaurant/", "statusCode": 301 },
    { "source": "/restaurant/", "destination": "/fr/restaurant/", "statusCode": 301 },
    { "source": "/galerie", "destination": "/fr/galerie/", "statusCode": 301 },
    { "source": "/galerie/", "destination": "/fr/galerie/", "statusCode": 301 },
    { "source": "/contact", "destination": "/fr/contact/", "statusCode": 301 },
    { "source": "/contact/", "destination": "/fr/contact/", "statusCode": 301 },
    { "source": "/conditions-reservation", "destination": "/fr/conditions-reservation/", "statusCode": 301 },
    { "source": "/conditions-reservation/", "destination": "/fr/conditions-reservation/", "statusCode": 301 }
  ],
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] }
  ]
}
